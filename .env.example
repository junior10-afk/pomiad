# ---------------------------------------------------------------------------
# PomiAD — configuration
# Copie ce fichier en `.env` puis remplis les clés. Un `.env` vide suffit pour
# lancer le serveur : l'app fonctionne alors en mode local (sans LLM, sans image).
# ---------------------------------------------------------------------------

PORT=8787

# --- Texte : analyse du site, angles de campagne, édition au prompt ---------
# Une seule clé suffit. Ordre de préférence si LLM_PROVIDER=auto :
# gemini -> openai -> anthropic.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# auto | gemini | openai | anthropic
LLM_PROVIDER=auto

# Vide = modèle par défaut du provider. À ajuster selon ton compte.
#   gemini     : gemini-2.5-flash
#   openai     : gpt-4o-mini
#   anthropic  : claude-sonnet-4-5
LLM_MODEL=

# --- Images : fonds de créa générés ----------------------------------------
# Optionnel. Sans clé image, les créas restent composés en vectoriel (canvas).

# gemini | openai | none
IMAGE_PROVIDER=

# Vide = défaut du provider.
#   gemini : gemini-2.5-flash-image   (Nano Banana)
#   openai : gpt-image-1
IMAGE_MODEL=

# --- Crawl ----------------------------------------------------------------
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_STYLESHEETS=8
